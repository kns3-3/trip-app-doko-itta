<div class="container mt-4">
  <div class="row">
    <div class="col-md-8 offset-md-2">

      <h1 class="mb-3"><%= @trip.title %></h1>

      <% if @trip.photo.attached? %>
        <%= image_tag @trip.photo, class: "img-fluid rounded mb-3", style: "max-height: 400px; object-fit: cover; width: 100%;" %>
      <% else %>
        <p class="text-muted">（画像はありません）</p>
      <% end %>

      <p><strong>住所：</strong><%= @trip.address %></p>
      <p><strong>訪問日：</strong><%= @trip.visited_at %></p>
      <p><strong>コメント：</strong><%= @trip.comment %></p>

      <% if logged_in? %>
        <% if current_user.favorite_trips.include?(@trip) %>
          <%= link_to "★ お気に入り解除", trip_favorite_path(@trip, current_user.favorites.find_by(trip: @trip)), data: { turbo_method: :delete }, class: "btn btn-warning me-2" %>
        <% else %>
          <%= link_to "☆ お気に入り追加", trip_favorites_path(@trip), data: { turbo_method: :post }, class: "btn btn-outline-warning me-2" %>
        <% end %>
      <% end %>

      <% if @trip.user == current_user %>
        <%= link_to "編集", edit_trip_path(@trip), class: "btn btn-secondary me-2" %>
        <%= link_to "削除", @trip, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger me-2" %>
      <% end %>

      <%= link_to "一覧に戻る", trips_path, class: "btn btn-outline-dark" %>

      <div id="map" class="mt-4 rounded" style="width: 100%; height: 400px;"></div>

      <script>
        function initMap() {
          const lat = <%= @trip.latitude || 35.6812 %>;
          const lng = <%= @trip.longitude || 139.7671 %>;
          const map = new google.maps.Map(document.getElementById("map"), {
            center: { lat: lat, lng: lng },
            zoom: 15,
          });
          new google.maps.Marker({
            position: { lat: lat, lng: lng },
            map: map,
          });
        }
      </script>

      <script async defer
        src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&callback=initMap">
      </script>
    </div>
  </div>
</div>
