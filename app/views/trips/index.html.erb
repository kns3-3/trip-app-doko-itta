<h1>旅行記録一覧</h1>

<%= link_to "新しい記録を投稿", new_trip_path %>

<% @trips.each do |trip| %>
  <div>
    <% if trip.photo.attached? %>
      <%= image_tag trip.photo, style: "width: 150px;" %>
    <% end %>
    <h2><%= link_to trip.title, trip %></h2>
    <p><%= trip.address %></p>
    <p><%= trip.visited_at %></p>
  </div>
<% end %>
