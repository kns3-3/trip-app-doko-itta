<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1 class="text-center mb-4">どこいったっけ？</h1>
      <p class="text-center text-muted">あなたの旅行記録を残そう</p>


      <%= form_with url: login_path do |f| %>
        <div class="mb-3">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password, class: "form-control" %>
        </div>

        <%= f.submit "ログイン", class: "btn btn-primary w-100 mb-2" %>
      <% end %>

        <%= button_to "ゲストログイン", guest_login_path, method: :post, class: "btn btn-outline-secondary w-100 mb-2" %>
        <%= link_to "新規登録はこちら", signup_path, class: "d-block text-center" %>
    </div>
  </div>
</div>
